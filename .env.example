# Supabase — copy this file to `.env` and fill in the values from your Supabase
# project (Dashboard -> Project Settings -> API). The anon/public key is safe to
# expose in the browser; it is protected by Row Level Security.
#
# On Vercel, add these same two variables under:
# Project -> Settings -> Environment Variables (Production + Preview).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
